<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application>
        <activity
            android:name="com.glystv.exo.PlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.glystvfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/glystv_paths" />
        </provider>
    </application>
</manifest>
