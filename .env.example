# ───────────────────────────────────────────────────────────────
#  GLYSTV-PRO · variables de entorno
#  Copia este archivo como .env y ajusta los valores. El archivo .env
#  está ignorado por git: nunca subas contraseñas al repositorio.
# ───────────────────────────────────────────────────────────────

# Conexión a PostgreSQL (obligatoria para ejecutar con `npm run dev` / `npm start`)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Carpeta donde se guardan las grabaciones DVR (opcional; por defecto ./data/recordings)
# RECORDINGS_DIR=/app/data/recordings

# ── Solo para `docker compose up` ───────────────────────────────
# Contraseña de la base de datos que crea Docker Compose
POSTGRES_PASSWORD=cambia-esta-clave
# Dominio público (Caddy obtiene el certificado HTTPS automáticamente).
# Usa "localhost" para probar en tu propio equipo.
DOMAIN=localhost
# Imagen a ejecutar. Déjalo comentado para compilar en el servidor; o usa la publicada por GitHub Actions:
# IMAGE=ghcr.io/<usuario>/<repositorio>:latest

# ── Seguridad y mantenimiento (opcionales, recomendadas en producción) ─────────
# Clave para cifrar las contraseñas de proveedores guardadas en la BD. Genera una con:
#   openssl rand -hex 32
# ¡No la cambies una vez en uso!
# APP_SECRET=
# Permitir proveedores en la red local (por defecto se bloquean las IPs privadas: protección SSRF)
# ALLOW_PRIVATE_URLS=0
# Días que se conservan las grabaciones terminadas (0 = para siempre)
# RECORDING_RETENTION_DAYS=30
# Horas entre actualizaciones automáticas de la guía EPG (0 = desactivar)
# EPG_REFRESH_HOURS=12
# Horas entre sincronizaciones automáticas del catálogo de los proveedores (0 = desactivar)
# PROVIDER_SYNC_HOURS=24

# ── Migraciones ───────────────────────────────────────────────────────────────
# La app actualiza el esquema sola al arrancar. Si detecta datos de un formato antiguo que
# no se pueden conservar, se NIEGA a arrancar y lo explica en los registros. Solo entonces,
# tras hacer copia de seguridad (pg_dump), arranca UNA vez con esta variable y luego quítala.
# ALLOW_DESTRUCTIVE_MIGRATION=0
